DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/ttt_timeline?sslmode=require
PORT=3000
EXCEL_SOURCE=C:\path\to\your\[TTT New] Planning.xlsx
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# free key from https://aistudio.google.com/apikey — powers the "Đánh giá AI" /
# chatbot features. Only used when LLM_PROVIDER is unset or not "ollama".
GEMINI_API_KEY=your-gemini-api-key
# set to "ollama" to route the chatbot / "Đánh giá AI" / gợi ý features to a
# local Ollama server instead of Gemini (see src/lib/llmClient.js).
# - Running the app itself locally: leave OLLAMA_URL unset (defaults to
#   http://localhost:11434, direct to Ollama).
# - Running the app on Render while Ollama stays on a home machine: point
#   OLLAMA_URL at that machine's scripts/ollama-bridge.js Tailscale Funnel
#   URL instead (e.g. https://your-mac.your-tailnet.ts.net:8443) and set
#   OLLAMA_BRIDGE_SECRET to match the bridge's — see that script for why a
#   bridge sits in front of Ollama rather than exposing it directly.
LLM_PROVIDER=ollama
# model to use when LLM_PROVIDER=ollama — must already be pulled locally:
#   ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_URL=http://localhost:11434
# OLLAMA_BRIDGE_SECRET=your-bridge-secret
# context window (tokens) requested from Ollama — defaults to 16384 in code
# (ollamaClient.js) since Ollama's own default of 4096 silently truncates a
# chatbot prompt this size (whole task/sprint dump can run 15-20k+ tokens).
# 32768 reproducibly HUNG this Ollama build on this machine with a real
# prompt (see ollamaClient.js comment) — don't raise this without retesting.
# OLLAMA_NUM_CTX=16384
# set to "1" to print every prompt sent to the LLM and reply received to
# stdout (see src/lib/llmClient.js) — for tuning SYSTEM_INSTRUCTION /
# buildChatbotContext.js against what the model actually saw. Leave unset
# on Render — full task/sprint dumps on every message would flood the logs.
# LLM_DEBUG=1
# if set (both), gates EVERY request behind one shared HTTP Basic Auth
# login — needed if the whole app (not just the ollama-bridge) is ever
# reachable from outside a trusted LAN, since requireRole.js otherwise
# trusts a client-supplied header with no per-request verification. Leave
# both unset for LAN-only / localhost use, or when Render is the only
# public entry point. Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64').replace(/[+/=]/g,''))"
BASIC_AUTH_USER=your-shared-username
BASIC_AUTH_PASS=your-shared-password
# --- scripts/ollama-bridge.js only (the small proxy that sits in front of
# Ollama on the home machine, separate process from the main app) ---
# port the bridge listens on locally, before being exposed via Funnel
# BRIDGE_PORT=8787
# shared secret the bridge requires on every request (must match the
# OLLAMA_BRIDGE_SECRET the remote app/Render sends above). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OLLAMA_BRIDGE_SECRET=your-bridge-secret
# shared secret for the nightly progress-snapshot cron (see
# .github/workflows/nightly-snapshot.yml) — must match the GitHub repo
# secret of the same name. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-secret
